# Umami (opcional). Copia a .env.local para probar en local; en Coolify, como "Build Variable".
# URL del script de tu instancia de Umami
VITE_UMAMI_SCRIPT_URL=https://umami.tudominio.com/script.js
# Website ID que da Umami al crear el sitio
VITE_UMAMI_WEBSITE_ID=
# Solo contar visitas en estos dominios (separados por comas); vacío = todos
VITE_UMAMI_DOMAINS=puente.tudominio.com
